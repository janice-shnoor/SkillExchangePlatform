generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(uuid())
  username            String            @unique @db.VarChar(30)
  name                String            @db.VarChar(80)
  avatarUrl           String?           @map("avatar_url")
  email               String            @unique @db.VarChar(160)
  passwordHash        String            @map("password_hash")
  role                UserRole          @default(USER)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  receivedRequests    ExchangeRequest[] @relation("ReceivedRequests")
  sentRequests        ExchangeRequest[] @relation("SentRequests")
  exchangesAsUserA    Exchange[]        @relation("ExchangesAsUserA")
  exchangesAsUserB    Exchange[]        @relation("ExchangesAsUserB")
  messages            Message[]         @relation("MessageSender")
  reviewsReceived     Review[]          @relation("ReviewsReceived")
  reviewsGiven        Review[]          @relation("ReviewsGiven")
  userSkills          UserSkill[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Skill {
  id               String            @id @default(uuid())
  name             String            @unique @db.VarChar(120)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  description      String?
  offeredRequests  ExchangeRequest[] @relation("OfferedSkillRequests")
  wantedRequests   ExchangeRequest[] @relation("WantedSkillRequests")
  offeredExchanges Exchange[]        @relation("OfferedSkillExchanges")
  wantedExchanges  Exchange[]        @relation("WantedSkillExchanges")
  userSkills       UserSkill[]

  @@map("skills")
}

model UserSkill {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  skillId     String      @map("skill_id")
  type        SkillType
  proficiency Proficiency
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, skillId, type, proficiency])
  @@map("user_skills")
}

model ExchangeRequest {
  id                  String        @id @default(uuid())
  senderId            String?       @map("sender_id")
  receiverId          String?       @map("receiver_id")
  senderUsername      String        @map("sender_username")
  receiverUsername    String        @map("receiver_username")
  senderSkillId       String?       @map("sender_skill_id")
  senderSkillName     String        @map("sender_skill_name")
  senderProficiency   Proficiency   @map("sender_proficiency")
  receiverSkillId     String?       @map("receiver_skill_id")
  receiverSkillName   String        @map("receiver_skill_name")
  receiverProficiency Proficiency   @map("receiver_proficiency")
  status              RequestStatus @default(PENDING)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  sender              User?         @relation("SentRequests", fields: [senderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receiver            User?         @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  senderSkill         Skill?        @relation("OfferedSkillRequests", fields: [senderSkillId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receiverSkill       Skill?        @relation("WantedSkillRequests", fields: [receiverSkillId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  exchange            Exchange?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("exchange_requests")
}

model Exchange {
  id          String          @id @default(uuid())
  requestId   String          @unique @map("request_id")
  userAId     String          @map("user_a_id")
  userBId     String          @map("user_b_id")
  skillAId    String          @map("skill_a_id")
  skillBId    String          @map("skill_b_id")
  status      ExchangeStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  request     ExchangeRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userA       User            @relation("ExchangesAsUserA", fields: [userAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userB       User            @relation("ExchangesAsUserB", fields: [userBId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skillA      Skill           @relation("OfferedSkillExchanges", fields: [skillAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skillB      Skill           @relation("WantedSkillExchanges", fields: [skillBId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]
  reviews     Review[]

  @@map("exchanges")
}

model Message {
  id         String    @id @default(uuid())
  exchangeId String    @map("exchange_id")
  senderId   String    @map("sender_id")
  content    String
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  exchange   Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender     User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([exchangeId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String   @id @default(uuid())
  exchangeId String   @map("exchange_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exchangeId, reviewerId])
  @@map("reviews")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum SkillType {
  OFFERED
  WANTED

  @@map("skill_type")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("request_status")
}

enum ExchangeStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("exchange_status")
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("proficiency")
}
